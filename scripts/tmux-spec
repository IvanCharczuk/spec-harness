#!/usr/bin/env bash
# RF-02..RF-06, RF-10 de
# spec 0037 (not in this snapshot)
# Abre (o reusa) un worktree hermano para una spec y una ventana de tmux con
# el agente adentro, sin Orca (RNF-01). "new" reserva id y rama antes de que
# la spec exista (RF-03); "close" deshace todo, sin forzar nada (RF-06).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
# shellcheck source=lib/routing.sh
# (heredamos resolve_spec/fm_field de lib/spec.sh, como the worktree helper (not in this snapshot))
source "$SELF_DIR/lib/routing.sh"
# shellcheck source=lib/worktree.sh
source "$SELF_DIR/lib/worktree.sh"
cd "$REPO_ROOT"

usage() {
  cat >&2 <<'EOF'
uso:
  scripts/tmux-spec <id|ruta> [--agent <nombre>] [--dry-run]
  scripts/tmux-spec new "<título>" [--agent <nombre>] [--dry-run]
  scripts/tmux-spec close <id|ruta>

  --agent <nombre>  agente que corre en la ventana nueva (default: claude)
  --dry-run         imprime, una acción por línea, lo que haría; no toca nada

exit: 0 ok | 1 close rechazado | 2 uso / spec inválida / target ocupado
EOF
}

# --- wrapper de tmux: TMUX_SPEC_SOCKET (si está) va como "-L <valor>" en
# todas las llamadas — existe para que las pruebas no toquen la sesión real
# del operador (RNF-03). --------------------------------------------------

TMUX_BASE=(tmux)
if [ -n "${TMUX_SPEC_SOCKET:-}" ]; then
  TMUX_BASE=(tmux -L "$TMUX_SPEC_SOCKET")
fi

tmux_c() { "${TMUX_BASE[@]}" "$@"; }
tmux_base_str() { printf '%s' "${TMUX_BASE[*]}"; }

# --- helpers de git worktree --------------------------------------------

# 0 si <wt_real> (path ya canonicalizado) está registrado como worktree de
# este repo en la rama <rama>; 1 si no (ni registrado, ni con esa rama).
wt_is_registered_branch() {
  local wt_real="$1" rama="$2" line path="" branch="" found=1
  while IFS= read -r line; do
    case "$line" in
      "worktree "*) path="${line#worktree }" ;;
      "branch "*) branch="${line#branch }" ;;
      "")
        if [ -n "$path" ]; then
          if [ "$(realpath -m "$path" 2>/dev/null)" = "$wt_real" ] && [ "$branch" = "refs/heads/$rama" ]; then
            found=0
          fi
        fi
        path=""; branch=""
        ;;
    esac
  done < <(git worktree list --porcelain; printf '\n')
  return "$found"
}

# 0 si <rama> ya existe (local, o remota conocida con nombre único) — para
# decidir entre `git worktree add WT <rama>` y `git worktree add -b <rama>
# WT main` (DWIM de git para el caso de una remota sin local todavía).
branch_already_exists() {
  local rama="$1"
  git show-ref --verify --quiet "refs/heads/$rama" && return 0
  git for-each-ref --format='%(refname)' "refs/remotes/*/$rama" 2>/dev/null | grep -q . && return 0
  return 1
}

# Resuelve <arg> contra specs/ de <dir> (para RF-06: siempre MAIN), no
# contra $REPO_ROOT del checkout desde el que se invoca.
resolve_spec_in() {
  local dir="$1" arg="$2" match
  case "$arg" in
    */*|*.md) printf '%s\n' "$arg"; return 0 ;;
    *)
      match="$(ls "$dir"/specs/"$arg"-*.md 2>/dev/null | head -1)"
      [ -n "$match" ] || return 1
      printf '%s\n' "$match"
      ;;
  esac
}

# --- RF-04: setup sin Orca, leyendo orca.yaml/.worktreeinclude como datos ---

# Lista de entradas de orca.yaml:worktree.sharedDirectories, en orden.
orca_shared_dirs() {
  local file="$1"
  [ -f "$file" ] || return 0
  awk '
    BEGIN { in_wt=0; in_sd=0 }
    /^[^ \t]/ { in_wt=(/^worktree:[ \t]*$/) ? 1 : 0; in_sd=0; next }
    in_wt && /^[ \t]+sharedDirectories:[ \t]*$/ { in_sd=1; next }
    in_wt && in_sd {
      if ($0 ~ /^[ \t]+-[ \t]*/) { v=$0; sub(/^[ \t]+-[ \t]*/, "", v); print v }
      else { in_sd=0 }
      next
    }
  ' "$file"
}

# Cuerpo del bloque literal orca.yaml:scripts.setup ("setup: |"), sin la
# indentación del bloque. Vacío si no hay.
orca_setup_script() {
  local file="$1"
  [ -f "$file" ] || return 0
  awk '
    BEGIN { in_scripts=0; in_setup=0; content_indent=-1 }
    /^[^ \t]/ { in_scripts=(/^scripts:[ \t]*$/) ? 1 : 0; in_setup=0; content_indent=-1; next }
    in_scripts && /^[ \t]+setup:[ \t]*\|[ \t]*$/ { in_setup=1; content_indent=-1; next }
    in_scripts && in_setup {
      if ($0 ~ /^[ \t]*$/) { if (content_indent >= 0) print ""; next }
      match($0, /^[ \t]*/); cur=RLENGTH
      if (content_indent < 0) content_indent=cur
      if (cur < content_indent) { in_setup=0; in_scripts=0 } else { print substr($0, content_indent+1) }
    }
  ' "$file"
}

# Líneas no vacías y no comentario de .worktreeinclude.
worktreeinclude_entries() {
  local file="$1"
  [ -f "$file" ] || return 0
  awk '!/^[[:space:]]*(#.*)?$/' "$file"
}

# Ejecuta el setup real, cwd = WT. Si el paso 3 falla: imprime WT y exit 1
# (sin abrir ventana) — mismo criterio que setupAgentStartupPolicy:
# wait-for-setup.
run_setup() {
  local wt="$1" main entry src dst line setup_script

  main="$(wt_main)"

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    src="$main/$entry"
    if [ ! -e "$src" ]; then
      echo "tmux-spec: setup: '$entry' no existe en $main; se saltea" >&2
      continue
    fi
    dst="$wt/$entry"
    mkdir -p "$(dirname "$dst")"
    ln -s "$src" "$dst"
  done < <(orca_shared_dirs "$main/orca.yaml")

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    src="$main/$line"
    [ -e "$src" ] || continue
    dst="$wt/$line"
    mkdir -p "$(dirname "$dst")"
    cp -a "$src" "$dst"
  done < <(worktreeinclude_entries "$main/.worktreeinclude")

  setup_script="$(orca_setup_script "$main/orca.yaml")"
  if [ -n "$setup_script" ]; then
    if ! ( cd "$wt" && bash -e -c "$setup_script" ); then
      echo "$wt"
      exit 1
    fi
  fi
}

# Imprime, sin ejecutar nada, las mismas acciones que run_setup (RF-10).
print_setup_dry_run() {
  local wt="$1" main entry src line setup_script

  main="$(wt_main)"

  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    src="$main/$entry"
    [ -e "$src" ] || continue
    printf 'ln -s %s %s\n' "$src" "$wt/$entry"
  done < <(orca_shared_dirs "$main/orca.yaml")

  while IFS= read -r line; do
    [ -n "$line" ] || continue
    src="$main/$line"
    [ -e "$src" ] || continue
    printf 'cp %s %s\n' "$src" "$wt/$line"
  done < <(worktreeinclude_entries "$main/.worktreeinclude")

  setup_script="$(orca_setup_script "$main/orca.yaml")"
  if [ -n "$setup_script" ]; then
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      printf 'setup: %s\n' "$line"
    done <<< "$setup_script"
  fi
}

# --- RF-05: ventana de tmux --------------------------------------------------

# Busca, dentro del target de sesión dado (vacío = sesión actual), una
# ventana de nombre <id> y devuelve su @id (window_id); vacío si no hay.
find_window() {
  local id="$1" target="${2:-}"
  if [ -n "$target" ]; then
    tmux_c list-windows -t "$target" -F '#{window_id} #{window_name}' 2>/dev/null \
      | awk -v n="$id" '$2==n{print $1; exit}' || true
  else
    tmux_c list-windows -F '#{window_id} #{window_name}' 2>/dev/null \
      | awk -v n="$id" '$2==n{print $1; exit}' || true
  fi
}

# Abre (o reusa, sin duplicar) la ventana <id> con "<agent> <prompt>" y
# cwd=wt. Dentro de tmux: sesión actual. Fuera: sesión "rmaestro" (se crea
# si hace falta) y, si stdout es una tty, attach; si no, imprime cómo
# adjuntarse y sale 0.
open_window() {
  local id="$1" wt="$2" agent="$3" prompt="$4" win

  if [ -n "${TMUX:-}" ]; then
    win="$(find_window "$id")"
    if [ -n "$win" ]; then
      tmux_c select-window -t "$win"
    else
      tmux_c new-window -n "$id" -c "$wt" -- "$agent" "$prompt"
    fi
    return 0
  fi

  if tmux_c has-session -t rmaestro 2>/dev/null; then
    win="$(find_window "$id" rmaestro)"
    if [ -n "$win" ]; then
      tmux_c select-window -t "$win"
    else
      tmux_c new-window -t rmaestro -n "$id" -c "$wt" -- "$agent" "$prompt"
    fi
  else
    tmux_c new-session -d -s rmaestro -n "$id" -c "$wt" -- "$agent" "$prompt"
  fi

  if [ -t 1 ]; then
    tmux_c attach -t rmaestro
  else
    printf 'tmux-spec: para adjuntarte: %s attach -t rmaestro\n' "$(tmux_base_str)"
  fi
}

# Mata la ventana <id> si existe (sesión actual, o "rmaestro"); si no
# existe, no hace nada (no es un rechazo).
close_window() {
  local id="$1" win=""
  if [ -n "${TMUX:-}" ]; then
    win="$(find_window "$id")"
  elif tmux_c has-session -t rmaestro 2>/dev/null; then
    win="$(find_window "$id" rmaestro)"
  fi
  if [ -n "$win" ]; then
    tmux_c kill-window -t "$win" || true
  fi
  return 0
}

emit_window() {
  local id="$1" wt="$2" agent="$3" prompt="$4" dry_run="$5"
  if [ "$dry_run" -eq 1 ]; then
    printf '%s new-window -n %s -c %s -- %s "%s"\n' "$(tmux_base_str)" "$id" "$wt" "$agent" "$prompt"
    return 0
  fi
  open_window "$id" "$wt" "$agent" "$prompt"
}

# --- RF-02: <id|ruta> ---------------------------------------------------

open_or_create_worktree() {
  local target_branch="$1" wt="$2" dry_run="$3"

  if [ -e "$wt" ]; then
    if wt_is_registered_branch "$(realpath -m "$wt")" "$target_branch"; then
      return 0
    fi
    echo "tmux-spec: '$wt' existe y no es un worktree de este repo en la rama '$target_branch'" >&2
    exit 2
  fi

  if [ "$dry_run" -eq 1 ]; then
    if branch_already_exists "$target_branch"; then
      printf 'git worktree add %s %s\n' "$wt" "$target_branch"
    else
      printf 'git worktree add -b %s %s main\n' "$target_branch" "$wt"
    fi
    print_setup_dry_run "$wt"
    return 0
  fi

  if branch_already_exists "$target_branch"; then
    git worktree add "$wt" "$target_branch"
  else
    git worktree add -b "$target_branch" "$wt" main
  fi
  wt_bloquear_push "$wt"
  run_setup "$wt"
}

cmd_open() {
  local spec_arg="${1:-}"
  [ -n "$spec_arg" ] || { usage; exit 2; }
  shift

  local agent="claude" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) [ $# -ge 2 ] || { usage; exit 2; }; agent="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) usage; exit 2 ;;
    esac
  done

  local spec_file target_branch id wt

  spec_file="$(resolve_spec "$spec_arg" 2>/dev/null || true)"
  if [ -z "$spec_file" ] || [ ! -f "$spec_file" ]; then
    echo "tmux-spec: no se pudo resolver spec '$spec_arg'" >&2
    exit 2
  fi

  target_branch="$(fm_field "$spec_file" target_branch)"
  if [ -z "$target_branch" ] || [ "$target_branch" = "spec/0000-slug" ]; then
    echo "tmux-spec: la spec '$spec_arg' no tiene target_branch (o quedó en el placeholder)" >&2
    exit 2
  fi

  id="$(fm_field "$spec_file" id)"
  [ -n "$id" ] || { echo "tmux-spec: la spec resuelta no tiene 'id' en el front-matter" >&2; exit 2; }

  wt="$(wt_path "$id")"

  open_or_create_worktree "$target_branch" "$wt" "$dry_run"
  emit_window "$id" "$wt" "$agent" "/rmaestro $id" "$dry_run"
}

# --- RF-03: new "<título>" -----------------------------------------------

cmd_new() {
  local title="${1:-}"
  [ -n "$title" ] || { echo "tmux-spec: new requiere un título no vacío" >&2; exit 2; }
  shift

  case "$title" in
    *'"'*|*$'\n'*)
      echo "tmux-spec: new: el título no puede tener comillas dobles ni saltos de línea" >&2
      exit 2
      ;;
  esac

  local agent="claude" dry_run=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --agent) [ $# -ge 2 ] || { usage; exit 2; }; agent="$2"; shift 2 ;;
      --dry-run) dry_run=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) usage; exit 2 ;;
    esac
  done

  local id slug target_branch wt

  id="$(wt_next_id)"
  slug="$(wt_branch_slug "$title")"
  if [ -z "$slug" ]; then
    echo "tmux-spec: new: el título no produce un slug de rama válido" >&2
    exit 2
  fi
  target_branch="spec/${id}-${slug}"
  wt="$(wt_path "$id")"

  if [ -e "$wt" ]; then
    echo "tmux-spec: new: '$wt' ya existe" >&2
    exit 2
  fi

  # RF-11: el worktree sale de main y el prompt usa --id/--target-branch
  # (RF-08); si el scripts/rmaestro de main no las acepta, la sesión nueva
  # fallaría o crearía la spec con otro id. Se corta antes de crear nada; en
  # --dry-run sólo se avisa, porque no se crea nada.
  if ! git -C "$(wt_main)" show main:scripts/rmaestro 2>/dev/null | grep -qE '^[[:space:]]*--id\)'; then
    if [ "$dry_run" -eq 1 ]; then
      echo "tmux-spec: aviso: el scripts/rmaestro de main no acepta --id (RF-08 de 0037 sin fusionar); sin --dry-run, new sale con exit 2" >&2
    else
      echo "tmux-spec: new: el scripts/rmaestro de main no acepta --id/--target-branch (RF-08 de 0037); fusioná 0037 a main antes de abrir specs nuevas" >&2
      exit 2
    fi
  fi

  if [ "$dry_run" -eq 1 ]; then
    printf 'git worktree add -b %s %s main\n' "$target_branch" "$wt"
    print_setup_dry_run "$wt"
  else
    # RF-07: reserva el id en main (commitea sessions/ids-reservados.jsonl)
    # antes de crear el worktree, para que otra sesión paralela no lo tome.
    wt_reservar "$id" "$target_branch" "$title"
    git worktree add -b "$target_branch" "$wt" main
    wt_bloquear_push "$wt"
    run_setup "$wt"
  fi

  local prompt
  prompt="$(printf '/rmaestro new "%s" --id %s --target-branch %s' "$title" "$id" "$target_branch")"

  emit_window "$id" "$wt" "$agent" "$prompt" "$dry_run"
}

# --- RF-06: close <id|ruta> ------------------------------------------------

# Guardia (supuesto aprobado, fuera de la letra de RF-06): no permite
# cerrar desde dentro del propio worktree ni desde la propia ventana <id>,
# porque el paso 2 (matar la ventana) mataría al propio script antes de
# los pasos 3 y 4.
guard_not_self() {
  local id="$1" wt="$2" cwd_real wt_real cur_win

  cwd_real="$(realpath -m "$PWD")"
  wt_real="$(realpath -m "$wt")"
  case "$cwd_real" in
    "$wt_real"|"$wt_real"/*)
      echo "tmux-spec: close: no se puede cerrar '$id' desde dentro de su propio worktree ($PWD)" >&2
      exit 1
      ;;
  esac

  # Con -t $TMUX_PANE: sin eso, display-message da la ventana activa del
  # cliente (p. ej. la <id> recién abierta), no la del pane que corre esto.
  if [ -n "${TMUX:-}" ] && [ -n "${TMUX_PANE:-}" ]; then
    cur_win="$(tmux_c display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || true)"
    if [ "$cur_win" = "$id" ]; then
      echo "tmux-spec: close: no se puede cerrar '$id' desde su propia ventana de tmux" >&2
      exit 1
    fi
  fi
}

cmd_close() {
  local arg="${1:-}"
  [ -n "$arg" ] || { usage; exit 2; }
  shift
  [ $# -eq 0 ] || { usage; exit 2; }

  local main spec_file id target_branch wt

  main="$(wt_main)"

  if spec_file="$(resolve_spec_in "$main" "$arg")" && [ -f "$spec_file" ]; then
    id="$(fm_field "$spec_file" id)"
    target_branch="$(fm_field "$spec_file" target_branch)"
    if [ -z "$target_branch" ]; then
      echo "tmux-spec: close: la spec '$id' no tiene target_branch" >&2
      exit 1
    fi
    wt="$(wt_path "$id")"
  else
    # RF-06 (v3): la spec de una sesión descartada nunca llega a main; con
    # un <id> de cuatro dígitos, la rama sale del worktree registrado en
    # wt_path <id>, y sólo si es spec/<id>-*.
    case "$arg" in
      [0-9][0-9][0-9][0-9]) ;;
      *) echo "tmux-spec: close: no se pudo resolver '$arg' en $main/specs" >&2; exit 1 ;;
    esac
    id="$arg"
    wt="$(wt_path "$id")"
    local wt_canon line cur=""
    wt_canon="$(realpath -m "$wt")"
    target_branch=""
    while IFS= read -r line; do
      case "$line" in
        "worktree "*) cur="$(realpath -m "${line#worktree }")" ;;
        "branch refs/heads/"*)
          if [ "$cur" = "$wt_canon" ]; then target_branch="${line#branch refs/heads/}"; break; fi ;;
      esac
    done < <(git -C "$main" worktree list --porcelain)
    case "$target_branch" in
      "spec/${id}-"*) ;;
      *)
        echo "tmux-spec: close: '$id' no está en $main/specs ni hay un worktree $wt en una rama spec/${id}-*" >&2
        exit 1
        ;;
    esac
  fi

  guard_not_self "$id" "$wt"

  # paso 1: la rama tiene que estar fusionada en main
  if ! git -C "$main" merge-base --is-ancestor "$target_branch" main 2>/dev/null; then
    echo "tmux-spec: close: la rama '$target_branch' no está fusionada en main" >&2
    exit 1
  fi

  # paso 2: matar la ventana <id>, si existe
  close_window "$id"

  # paso 3: sacar el worktree — sin forzar: si git lo rechaza, se propaga
  if ! git -C "$main" worktree remove "$wt"; then
    echo "tmux-spec: close: git rechazó sacar el worktree '$wt'" >&2
    exit 1
  fi

  # paso 4: borrar la rama — sólo si git la considera ya fusionada
  if ! git -C "$main" branch -d "$target_branch"; then
    echo "tmux-spec: close: git rechazó borrar la rama '$target_branch'" >&2
    exit 1
  fi
}

# --- dispatch ----------------------------------------------------------------

[ $# -ge 1 ] || { usage; exit 2; }

case "$1" in
  -h|--help) usage; exit 0 ;;
  new) shift; cmd_new "$@" ;;
  close) shift; cmd_close "$@" ;;
  *) cmd_open "$@" ;;
esac
