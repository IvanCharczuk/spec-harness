#!/usr/bin/env bash
# RF-11 de specs/0001-repo-maestro.md.
# Implementado por spec 0008 (not in this snapshot).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
# shellcheck source=lib/spec.sh
source "$SELF_DIR/lib/spec.sh"
# shellcheck source=lib/session_log.sh
source "$SELF_DIR/lib/session_log.sh"
cd "$REPO_ROOT"

usage() {
  cat >&2 <<'EOF'
uso:
  scripts/escalate <id|ruta> [--routing-config <path>] [--profiles-dir <path>]
                   [--locks-dir <path>] [--sessions-log <path>]
                   [-- <args para el binario del tier>]
EOF
}

# --- parseo de argumentos -----------------------------------------------

SPEC_ARG="${1:-}"
case "$SPEC_ARG" in
  -h|--help) usage; exit 0 ;;
  "") echo "escalate: falta <id|ruta>" >&2; usage; exit 2 ;;
esac
shift

ROUTING_CONFIG="$REPO_ROOT/config/routing.yaml"
PROFILES_DIR="$REPO_ROOT/config/profiles"
LOCKS_DIR="$REPO_ROOT/.state/locks"
SESSIONS_LOG="$REPO_ROOT/sessions/index.jsonl"
EXTRA_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --routing-config) ROUTING_CONFIG="${2:-}"; shift 2 ;;
    --profiles-dir) PROFILES_DIR="${2:-}"; shift 2 ;;
    --locks-dir) LOCKS_DIR="${2:-}"; shift 2 ;;
    --sessions-log) SESSIONS_LOG="${2:-}"; shift 2 ;;
    --) shift; EXTRA_ARGS=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    *) echo "escalate: argumento desconocido: $1" >&2; usage; exit 2 ;;
  esac
done

if ! SPEC_FILE="$(resolve_spec "$SPEC_ARG")" || [ ! -f "$SPEC_FILE" ]; then
  echo "escalate: no se pudo resolver spec '$SPEC_ARG'" >&2
  exit 2
fi
SPEC_ID="$(basename "$SPEC_FILE" | grep -oE '^[0-9]{4}' || true)"
[ -z "$SPEC_ID" ] && SPEC_ID="$(basename "$SPEC_FILE" .md)"

# --- helpers de parseo de sessions/index.jsonl (RNF-01: awk/grep, sin
# jq/node) ---------------------------------------------------------------

# Valor "plano" de un campo escalar de primer nivel — sin comillas si era
# string, tal cual si era número/null. Uso: comparaciones y campos que
# build_session_line ya envuelve en comillas por su cuenta (started_at,
# tier, profile, routing_rule, workspace, verify_result, outcome) o que
# son numéricos/null (spec_version, score, files_touched).
json_field_of_line() {
  local line="$1" key="$2" val
  val="$(printf '%s' "$line" | grep -oE "\"$key\":\"[^\"]*\"" | head -1 | sed -E "s/\"$key\":\"//; s/\"\$//")"
  if [ -n "$val" ]; then
    printf '%s' "$val"
    return
  fi
  printf '%s' "$line" | grep -oE "\"$key\":[^,}]*" | head -1 | sed -E "s/\"$key\"://"
}

# Valor "crudo" (fragmento JSON completo, con comillas si corresponde) —
# uso: override_reason/escalated_from, que build_session_line espera
# recibir ya formados (null o "\"texto\"").
json_raw_field_of_line() {
  local line="$1" key="$2"
  printf '%s' "$line" | grep -oE "\"$key\":(\"[^\"]*\"|[^,}]*)" | head -1 | sed -E "s/\"$key\"://"
}

# signals es el único campo anidado — extracción dedicada.
json_signals_of_line() {
  printf '%s' "$1" | grep -oE '"signals":\{[^}]*\}' | sed -E 's/^"signals"://'
}

# --- RF-04: localización de la línea a corregir, dos condiciones -----------

CORRECTION_SOURCE_LINE=""
if [ -f "$SESSIONS_LOG" ]; then
  LAST_TIER_A_ABORTED=""
  LAST_OVERALL=""
  while IFS= read -r l; do
    [ -z "$l" ] && continue
    this_spec_id="$(json_field_of_line "$l" spec_id)"
    [ "$this_spec_id" = "$SPEC_ID" ] || continue
    LAST_OVERALL="$l"
    this_tier="$(json_field_of_line "$l" tier)"
    this_outcome="$(json_field_of_line "$l" outcome)"
    if [ "$this_tier" = "TIER_A" ] && [ "$this_outcome" = "aborted" ]; then
      LAST_TIER_A_ABORTED="$l"
    fi
  done < "$SESSIONS_LOG"
  if [ -n "$LAST_TIER_A_ABORTED" ]; then
    if [ "$LAST_TIER_A_ABORTED" = "$LAST_OVERALL" ]; then
      CORRECTION_SOURCE_LINE="$LAST_TIER_A_ABORTED"
    else
      echo "escalate: la última actividad de esta spec no es el abort que se está intentando escalar" >&2
      exit 1
    fi
  fi
fi

if [ -z "$CORRECTION_SOURCE_LINE" ]; then
  echo "escalate: no hay sesión Tier A abortada reciente para esta spec" >&2
  exit 1
fi

ORIG_SESSION_ID="$(json_field_of_line "$CORRECTION_SOURCE_LINE" session_id)"
ORIG_SPEC_VERSION="$(json_field_of_line "$CORRECTION_SOURCE_LINE" spec_version)"

# --- RF-02: precondición de versión bumpeada --------------------------------

CURRENT_VERSION="$(fm_field "$SPEC_FILE" version)"
if ! [ "$CURRENT_VERSION" -gt "$ORIG_SPEC_VERSION" ] 2>/dev/null; then
  echo "escalate: la spec no fue bumpeada (version actual=$CURRENT_VERSION, sesión escalada tenía spec_version=$ORIG_SPEC_VERSION)" >&2
  exit 1
fi

# --- RF-03: precondición de entrada de §Historial para la versión actual ---

historial_body() {
  awk '
    /^## §Historial/ { insec=1; next }
    insec && /^## / { exit }
    insec { print }
  ' "$1"
}

if ! historial_body "$SPEC_FILE" | grep -qE -- "— v${CURRENT_VERSION} —"; then
  echo "escalate: falta la entrada de §Historial para la versión actual (v$CURRENT_VERSION)" >&2
  exit 1
fi

# --- RF-05: re-chequeo de route sobre la spec ya actualizada ----------------

set +e
ROUTE_OUTPUT="$("$REPO_ROOT/scripts/route" --spec "$SPEC_FILE" --routing-config "$ROUTING_CONFIG")"
ROUTE_EXIT=$?
set -e
echo "$ROUTE_OUTPUT"

NEW_TIER="$(printf '%s\n' "$ROUTE_OUTPUT" | grep -oE 'TIER=[AB]' | head -1 | cut -d= -f2)"
if [ "$ROUTE_EXIT" -ne 0 ] || [ "$NEW_TIER" != "B" ]; then
  echo "escalate: el score tras el bump no da TIER_B — escalado rechazado, nada se tocó" >&2
  exit 1
fi

# --- RF-06: terminación de la sesión Tier A (no-op si ya está cerrada) -----

"$REPO_ROOT/scripts/kill" personal --locks-dir "$LOCKS_DIR" || true

# --- RF-07: línea de corrección, mismo session_id, campos copiados
# verbatim salvo outcome/ended_at/notes — escrita antes de RF-08 (D2) ------

ORIG_SPEC_ID_F="$(json_field_of_line "$CORRECTION_SOURCE_LINE" spec_id)"
ORIG_STARTED_AT="$(json_field_of_line "$CORRECTION_SOURCE_LINE" started_at)"
ORIG_TIER="$(json_field_of_line "$CORRECTION_SOURCE_LINE" tier)"
ORIG_PROFILE="$(json_field_of_line "$CORRECTION_SOURCE_LINE" profile)"
ORIG_ROUTING_RULE="$(json_field_of_line "$CORRECTION_SOURCE_LINE" routing_rule)"
ORIG_SCORE="$(json_field_of_line "$CORRECTION_SOURCE_LINE" score)"
ORIG_WORKSPACE="$(json_field_of_line "$CORRECTION_SOURCE_LINE" workspace)"
ORIG_FILES_TOUCHED="$(json_field_of_line "$CORRECTION_SOURCE_LINE" files_touched)"
ORIG_VERIFY_RESULT="$(json_field_of_line "$CORRECTION_SOURCE_LINE" verify_result)"
ORIG_OVERRIDE_REASON_JSON="$(json_raw_field_of_line "$CORRECTION_SOURCE_LINE" override_reason)"
ORIG_ESCALATED_FROM_JSON="$(json_raw_field_of_line "$CORRECTION_SOURCE_LINE" escalated_from)"
ORIG_SIGNALS_JSON="$(json_signals_of_line "$CORRECTION_SOURCE_LINE")"

ENDED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
CORR_NOTES="$(json_escape "corrige outcome de la línea anterior con el mismo session_id")"

CORRECTION_LINE=$(build_session_line \
  "$ORIG_SESSION_ID" "$ORIG_SPEC_ID_F" "$ORIG_SPEC_VERSION" "$ORIG_STARTED_AT" "$ENDED_AT" \
  "$ORIG_TIER" "$ORIG_PROFILE" "$ORIG_ROUTING_RULE" "$ORIG_OVERRIDE_REASON_JSON" "$ORIG_SCORE" \
  "$ORIG_SIGNALS_JSON" "$ORIG_ESCALATED_FROM_JSON" "$ORIG_WORKSPACE" "$ORIG_FILES_TOUCHED" \
  "$ORIG_VERIFY_RESULT" "escalated" "$CORR_NOTES")

append_session_line "$SESSIONS_LOG" "$LOCKS_DIR" "$CORRECTION_LINE"

# --- RF-08: apertura de la sesión Tier B, bloqueante, foreground ------------
# Bare statement (no capturado en variable): bajo "set -e", si esta
# invocación falla, el script aborta acá mismo con su exit code — que es
# exactamente "el fallo se propaga en el exit code de escalate" (RF-08).
# La corrección de RF-07 ya quedó escrita antes de este punto (D2).

if [ "${#EXTRA_ARGS[@]}" -gt 0 ]; then
  "$REPO_ROOT/scripts/session" work --spec "$SPEC_FILE" \
    --routing-config "$ROUTING_CONFIG" --profiles-dir "$PROFILES_DIR" \
    --locks-dir "$LOCKS_DIR" --sessions-log "$SESSIONS_LOG" \
    --escalated-from "$ORIG_SESSION_ID" -- "${EXTRA_ARGS[@]}"
else
  "$REPO_ROOT/scripts/session" work --spec "$SPEC_FILE" \
    --routing-config "$ROUTING_CONFIG" --profiles-dir "$PROFILES_DIR" \
    --locks-dir "$LOCKS_DIR" --sessions-log "$SESSIONS_LOG" \
    --escalated-from "$ORIG_SESSION_ID"
fi
