#!/usr/bin/env bash
# RF-18 — Doctor. Checks 18.1, 18.5, 18.8, 18.9, 18.10 y 18.12, cada uno con
# exit 0/1 individual; el script devuelve 0 sólo si pasan todos. 18.7 se sacó
# en 0093; 18.2/.3/.4/.6/.11 y la parte de sesiones de 18.10, en 0096 (retiro
# del legado tier/dsh).
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
# shellcheck source=lib/spec.sh
# (0093: fm_field; spec.sh sólo define funciones, sin efectos laterales)
# 0098 también lo usa en el chequeo de reemplazos (RF-05).
source "$SELF_DIR/lib/spec.sh"
cd "$REPO_ROOT"
EXCEPTIONS_FILE="config/doctor-exceptions.yaml"
EXCEPTIONS_DETAIL=""

# RF-03 de 0028: único argumento opcional `--exceptions <path>`. Sin
# argumentos, EXCEPTIONS_FILE ya trae la ruta por defecto. Ruta inexistente
# equivale a lista vacía. 0093: se parsea acá, antes de 18.8/18.9, que
# también leen las excepciones.
case "$#" in
  0) : ;;
  2)
    if [ "${1:-}" = "--exceptions" ] && [ -n "${2:-}" ]; then
      EXCEPTIONS_FILE="$2"
    else
      echo "uso: scripts/doctor [--exceptions <path>]" >&2
      exit 2
    fi
    ;;
  *)
    echo "uso: scripts/doctor [--exceptions <path>]" >&2
    exit 2
    ;;
esac

FAILS=0
PASSES=0

fail_check() { print_fail "$1"; FAILS=$((FAILS + 1)); }
# El total de la línea final sale de este contador, no de un número fijo
# (0096): agregar o sacar un check no obliga a tocar el mensaje.
pass_check() { print_pass "$1"; PASSES=$((PASSES + 1)); }

# 1) Node dentro del rango soportado (RNF-01) --------------------------------
if check_node_range; then
  pass_check "RF-18.1 Node $(node_version_string) dentro del rango (^22.19.0 || >=24.0.0)"
else
  fail_check "RF-18.1 Node $(node_version_string) fuera del rango (^22.19.0 || >=24.0.0)"
fi

# 5) Ningún archivo trackeado contiene material credencial -------------------
# scan_credential_hits (RF-01 de spec 0009 (not in this snapshot), scripts/lib/
# common.sh) — misma lógica que antes, ahora compartida con los hooks.
hits=""
abs_path_hits=""
# 0029 v2: `git rev-parse` en vez de `[ -d .git ]` — en un worktree .git es
# un archivo y el check entero se saltaba (hallado en Orca, CA-08 de 0029).
if command -v git >/dev/null 2>&1 && git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  hits="$(git ls-files | scan_credential_hits)"
  # RF-03 de specs/0029: ninguna ruta absoluta del home de macOS versionada
  # fuera de specs/ (ahí hay prosa con ejemplos históricos, 0006/0026 — D3
  # de 0029). El patrón se arma partido para que este propio archivo no se
  # autodetecte al grepear por él.
  abs_pattern="/Us""ers/"
  # git grep --cached en vez de ls-files | xargs: los nombres con espacios
  # partían el xargs y no se escaneaban (0029 v2).
  abs_path_hits="$(git -C "$REPO_ROOT" grep -l --cached -F "$abs_pattern" -- . ':!specs/' 2>/dev/null || true)"
fi
check5_ok=1
if [ -n "$hits" ]; then
  fail_check "RF-18.5 posible material credencial en: $(echo "$hits" | tr '\n' ' ')"
  check5_ok=0
fi
if [ -n "$abs_path_hits" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    fail_check "RF-18.5 ruta absoluta versionada: $f"
  done <<< "$abs_path_hits"
  check5_ok=0
fi
if [ "$check5_ok" -eq 1 ]; then
  pass_check "RF-18.5 ningún archivo trackeado matchea patrones heurísticos de credenciales; ni rutas absolutas versionadas fuera de specs/"
fi

# exceptions_specs <archivo> <clave>: extrae rf_18_8/rf_18_9[] (0093), mismo
# estilo que exceptions_commits: awk lineal, sin tocar scripts/lib. Lee la
# línea de la clave y las indentadas siguientes hasta la próxima clave de
# primer nivel; acepta `rf_18_8: [{spec: "0019", motivo: "..."}]` en una
# línea o entradas `- spec:` indentadas. Imprime `id<TAB>motivo` por entrada
# (motivo vacío si falta). Archivo inexistente o clave ausente = vacío.
exceptions_specs() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  awk -v key="$key" '
    /^[^[:space:]#][^:]*:/ { inkey = (index($0, key ":") == 1); if (inkey) { txt = txt " " $0 }; next }
    /^[[:space:]]*#/ { next }
    inkey && /^[[:space:]]+-[[:space:]]/ { txt = txt "}" $0; next }
    inkey { txt = txt " " $0 }
    END {
      n = split(txt, parts, "}")
      for (i = 1; i <= n; i++) {
        if (!match(parts[i], /spec:[[:space:]]*"[^"]+"/)) continue
        id = substr(parts[i], RSTART, RLENGTH)
        sub(/^spec:[[:space:]]*"/, "", id); sub(/"$/, "", id)
        mot = ""
        if (match(parts[i], /motivo:[[:space:]]*"[^"]*"/)) {
          mot = substr(parts[i], RSTART, RLENGTH)
          sub(/^motivo:[[:space:]]*"/, "", mot); sub(/"$/, "", mot)
        }
        printf "%s\t%s\n", id, mot
      }
    }
  ' "$file"
}

# 8/9) specs implementing/verified tienen registro vivo (0093) --------------
# implementing: sessions/rojo/<id>.txt o línea "spec_id":"<id>" en
# sessions/rutas.jsonl. verified: commit `spec(<id>): implementing → verified`
# en git log. El id sale del front-matter (fm_field), no del nombre de
# archivo; una spec sin front-matter reconocible (0001) se saltea.
# Imprime el detalle por infractor y deja los ids en SPEC_BAD_IDS.
SPEC_BAD_IDS=""
SPEC_EXC_COUNT=0
check_spec_state() {
  local want="$1" key="$2" label="$3"
  local rc=0 f id st subjects="" have_git=0 ok viol="" exc_ids="" v eid emot
  SPEC_BAD_IDS=""
  SPEC_EXC_COUNT=0
  if [ "$want" = "verified" ]; then
    if git -C "$REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
      have_git=1
      subjects="$(git -C "$REPO_ROOT" log --format=%s 2>/dev/null || true)"
    fi
  fi
  for f in "$REPO_ROOT"/specs/*.md; do
    [ -f "$f" ] || continue
    st="$(fm_field "$f" status || true)"
    [ "$st" = "$want" ] || continue
    id="$(fm_field "$f" id || true)"
    if [ -z "$id" ]; then
      echo "  $f en $want sin id en front-matter"
      rc=1
      continue
    fi
    ok=0
    if [ "$want" = "implementing" ]; then
      if [ -f "$REPO_ROOT/sessions/rojo/$id.txt" ] \
         || grep -qF "\"spec_id\":\"$id\"" "$REPO_ROOT/sessions/rutas.jsonl" 2>/dev/null; then
        ok=1
      fi
    else
      if [ "$have_git" -eq 0 ]; then
        echo "  $label sin historial git: no se puede comprobar $id"
        return 1
      fi
      # Un solo git log capturado; awk index()==1 busca el prefijo (la flecha
      # es UTF-8) sin grep -q en pipe, que con pipefail daría 141 por SIGPIPE.
      if printf '%s\n' "$subjects" | awk -v p="spec($id): implementing → verified" 'index($0, p) == 1 { f = 1 } END { exit !f }'; then
        ok=1
      fi
    fi
    [ "$ok" -eq 1 ] || viol="$viol$id"$'\n'
  done

  while IFS=$'\t' read -r eid emot; do
    [ -n "$eid" ] || continue
    if [ -z "$emot" ]; then
      echo "  $label excepción inválida: $eid sin motivo"
      rc=1
      continue
    fi
    case $'\n'"$viol" in
      *$'\n'"$eid"$'\n'*)
        exc_ids="$exc_ids$eid"$'\n'
        SPEC_EXC_COUNT=$((SPEC_EXC_COUNT + 1))
        ;;
      *)
        echo "  $label excepción innecesaria: $eid ya cumple la regla"
        rc=1
        ;;
    esac
  done < <(exceptions_specs "$EXCEPTIONS_FILE" "$key")

  while IFS= read -r v; do
    [ -n "$v" ] || continue
    case $'\n'"$exc_ids" in
      *$'\n'"$v"$'\n'*) ;;
      *)
        if [ "$want" = "implementing" ]; then
          echo "  spec $v en implementing sin sessions/rojo/$v.txt ni línea en sessions/rutas.jsonl"
        else
          echo "  spec $v en verified sin commit 'spec($v): implementing → verified'"
        fi
        SPEC_BAD_IDS="${SPEC_BAD_IDS:+$SPEC_BAD_IDS }$v"
        rc=1
        ;;
    esac
  done <<< "$viol"
  return $rc
}
if check_spec_state "implementing" "rf_18_8" "RF-18.8"; then
  pass_check "RF-18.8 toda spec en implementing tiene registro (sessions/rojo o rutas.jsonl; $SPEC_EXC_COUNT exceptuadas)"
else
  fail_check "RF-18.8 spec en implementing sin registro o excepción inválida${SPEC_BAD_IDS:+: $SPEC_BAD_IDS}"
fi
if check_spec_state "verified" "rf_18_9" "RF-18.9"; then
  pass_check "RF-18.9 toda spec en verified tiene su commit implementing → verified ($SPEC_EXC_COUNT exceptuadas)"
else
  fail_check "RF-18.9 spec en verified sin commit implementing → verified o excepción inválida${SPEC_BAD_IDS:+: $SPEC_BAD_IDS}"
fi

# 10) commits con trailer Spec-Id válido (0096: sin la parte de sesiones) ----
check10_commits() {
  # El argumento `--exceptions <path>` se parsea al principio del script (0093).

  # exceptions_commits: extrae rf_18_10[].commit del YAML de excepciones
  # (RF-01/02 de 0028), mismo estilo que yaml_list de scripts/rutas: awk
  # lineal, sin tocar scripts/lib.
  exceptions_commits() {
    local file="$1"
    [ -f "$file" ] || return 0
    awk '
      /^[^[:space:]#][^:]*:[[:space:]]*/ { inkey = ($0 ~ "^rf_18_10:") ; next }
      inkey && /^[[:space:]]+-[[:space:]]+commit:[[:space:]]*/ {
        v=$0
        sub(/^[[:space:]]+-[[:space:]]+commit:[[:space:]]*/, "", v)
        sub(/[[:space:]]*#.*/, "", v)
        print v
      }
    ' "$file"
  }

  local rc=0 commit files touches_nonspec f spec_id
  local -a exc_hashes=()
  local h reason_raw reason_trimmed
  local exc_count=0

  if [ -f "$EXCEPTIONS_FILE" ]; then
    while IFS= read -r h; do
      [ -n "$h" ] || continue
      if ! printf '%s' "$h" | grep -qE '^[0-9a-f]{40}$' || ! git cat-file -e "${h}^{commit}" 2>/dev/null; then
        echo "  RF-18.10 excepción inválida: $h no es un commit de este repo"
        rc=1
        continue
      fi
      exc_hashes+=("$h")
    done < <(exceptions_commits "$EXCEPTIONS_FILE")
  fi

  while IFS= read -r commit; do
    [ -n "$commit" ] || continue
    local is_excepted=0
    for h in "${exc_hashes[@]:-}"; do
      [ -n "$h" ] && [ "$h" = "$commit" ] && is_excepted=1
    done

    files="$(git show --name-only --format= "$commit" 2>/dev/null || true)"
    touches_nonspec=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # is_code_or_config_path (RF-01 de spec 0009 (not in this snapshot),
      # scripts/lib/common.sh) — misma lógica que antes, ahora
      # compartida con .githooks/commit-msg.
      is_code_or_config_path "$f" && touches_nonspec=1
    done <<< "$files"

    local commit_valid=1 commit_reason=""
    if [ "$touches_nonspec" -eq 1 ]; then
      spec_id="$(git show -s --format=%B "$commit" | grep -m1 '^Spec-Id:' | sed 's/^Spec-Id:[[:space:]]*//' | tr -d '[:space:]')"
      if [ -z "$spec_id" ]; then
        commit_valid=0
        commit_reason="commit $commit toca código/config sin trailer Spec-Id"
      elif [ "$spec_id" = "none" ]; then
        # RF-06 de spec 0009 (not in this snapshot): "Spec-Id: none" es válido si
        # el commit trae también un trailer Spec-Id-Reason: no vacío —
        # mismo criterio exacto que .githooks/commit-msg, no una versión
        # relajada acá.
        reason_raw="$(git show -s --format=%B "$commit" | grep -m1 '^Spec-Id-Reason:' | sed 's/^Spec-Id-Reason:[[:space:]]*//' || true)"
        reason_trimmed="$(printf '%s' "$reason_raw" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
        if [ -z "$reason_trimmed" ]; then
          commit_valid=0
          commit_reason="commit $commit dice Spec-Id: none sin trailer Spec-Id-Reason no vacío"
        fi
      elif ! ls "$REPO_ROOT"/specs/"$spec_id"-*.md >/dev/null 2>&1; then
        commit_valid=0
        commit_reason="commit $commit referencia Spec-Id $spec_id inexistente en specs/"
      fi
    fi

    if [ "$is_excepted" -eq 1 ]; then
      if [ "$commit_valid" -eq 1 ]; then
        echo "  RF-18.10 excepción innecesaria: $commit cumple la regla"
        rc=1
      else
        exc_count=$((exc_count + 1))
      fi
    elif [ "$touches_nonspec" -eq 1 ] && [ "$commit_valid" -eq 0 ]; then
      echo "  $commit_reason"
      rc=1
    fi
  done < <(git -C "$REPO_ROOT" log --format=%H 2>/dev/null || true)

  # RF-02.4 de 0028: el detalle de cuántos se exceptuaron lo imprime la
  # línea [PASS] del bloque de abajo, vía esta variable.
  EXCEPTIONS_DETAIL=" ($exc_count exceptuados por $EXCEPTIONS_FILE)"
  return $rc
}
if check10_commits; then
  pass_check "RF-18.10 cero commits sin trailer Spec-Id válido${EXCEPTIONS_DETAIL:-}"
else
  fail_check "RF-18.10 hay commits sin trailer Spec-Id válido"
fi

# 12) scripts/agentes generar --check sin diferencias (RF-18.12, 0093) -------
if [ -x "$REPO_ROOT/scripts/agentes" ]; then
  out="$("$REPO_ROOT/scripts/agentes" generar --check 2>&1)"; rc=$?
else
  out="scripts/agentes no existe o no es ejecutable"; rc=1
fi
if [ "$rc" -eq 0 ]; then
  pass_check "RF-18.12 agentes generar --check sin diferencias"
else
  printf '%s\n' "$out" | sed 's/^/  /'
  fail_check "RF-18.12 agentes generar --check con diferencias (exit $rc)"
fi

# Reemplazos consistentes (RF-05 de specs/0001-repo-maestro.md)
# (a) si una spec declara supersedes X y X existe, X está en superseded;
# (b) una spec en superseded tiene un superseded_by que existe en specs/.
# '' y 'null' cuentan como ausente. Si X no existe, (a) no aplica.
check_reemplazos() {
  local rc=0 f id st sup sup_file sup_st sb sb_file
  for f in "$REPO_ROOT"/specs/*.md; do
    [ -e "$f" ] || continue
    id="$(fm_field "$f" id || true)"
    [ -n "$id" ] || id="$(basename "$f" .md)"
    sup="$(fm_field "$f" supersedes || true)"
    if [ -n "$sup" ] && [ "$sup" != "null" ]; then
      sup_file="$(ls "$REPO_ROOT"/specs/"$sup"-*.md 2>/dev/null | head -1 || true)"
      if [ -n "$sup_file" ]; then
        sup_st="$(fm_field "$sup_file" status || true)"
        if [ "$sup_st" != "superseded" ]; then
          echo "  $id declara supersedes $sup, que está en ${sup_st:-(sin status)}"
          rc=1
        fi
      fi
    fi
    st="$(fm_field "$f" status || true)"
    if [ "$st" = "superseded" ]; then
      sb="$(fm_field "$f" superseded_by || true)"
      if [ -z "$sb" ] || [ "$sb" = "null" ]; then
        echo "  $id está en superseded sin superseded_by"
        rc=1
      else
        sb_file="$(ls "$REPO_ROOT"/specs/"$sb"-*.md 2>/dev/null | head -1 || true)"
        if [ -z "$sb_file" ]; then
          echo "  $id está en superseded con superseded_by $sb, que no existe en specs/"
          rc=1
        fi
      fi
    fi
  done
  return $rc
}
if check_reemplazos; then
  pass_check "RF-05 de 0098: reemplazos consistentes (supersedes ↔ superseded_by)"
else
  fail_check "RF-05 de 0098: reemplazos consistentes (supersedes ↔ superseded_by)"
fi

# Negaciones que no cortan (RF-04 de 0100): sólo aviso, no es un check.
# shellcheck source=lib/negaciones.sh
source "$SELF_DIR/lib/negaciones.sh"
for f in "$REPO_ROOT"/specs/*.md; do
  [ -e "$f" ] || continue
  rel="specs/$(basename "$f")"
  while IFS="$(printf '\t')" read -r n ca _; do
    [ -n "$n" ] || continue
    echo "[AVISO] negación que no corta: $rel:$n $ca"
  done <<EOF2
$(negaciones_sueltas "$f" || true)
EOF2
done

echo
if [ "$FAILS" -eq 0 ]; then
  echo "doctor: $PASSES/$PASSES checks OK"
  exit 0
else
  echo "doctor: $FAILS check(s) en FAIL"
  exit 1
fi
