#!/usr/bin/env bash
# RF-04, RF-21 de specs/0001-repo-maestro.md.
# Implementado por spec 0004 (not in this snapshot).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
# shellcheck source=lib/routing.sh
source "$SELF_DIR/lib/routing.sh"
# shellcheck source=lib/session_log.sh
source "$SELF_DIR/lib/session_log.sh"
cd "$REPO_ROOT"

usage() {
  cat >&2 <<'EOF'
uso:
  scripts/session <personal|work> --spec <id|ruta> [--force --reason "<texto>"]
                  [--routing-config <path>] [--profiles-dir <path>]
                  [--locks-dir <path>] [--sessions-log <path>]
                  [--escalated-from <session_id>]
                  [-- <args para el binario del tier>]
EOF
}

to_abs() {
  case "$1" in
    /*) printf '%s' "$1" ;;
    *) printf '%s' "$REPO_ROOT/$1" ;;
  esac
}

# --- parseo de argumentos -----------------------------------------------

TIER="${1:-}"
case "$TIER" in
  personal|work) shift ;;
  -h|--help) usage; exit 0 ;;
  *) echo "session: tier inválido o faltante: '$TIER' (debe ser personal|work)" >&2; usage; exit 2 ;;
esac

SPEC_ARG=""
FORCE=0
REASON=""
ROUTING_CONFIG="$REPO_ROOT/config/routing.yaml"
PROFILES_DIR="$REPO_ROOT/config/profiles"
LOCKS_DIR="$REPO_ROOT/.state/locks"
SESSIONS_LOG="$REPO_ROOT/sessions/index.jsonl"
ESCALATED_FROM=""
EXTRA_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --spec) SPEC_ARG="${2:-}"; shift 2 ;;
    --force) FORCE=1; shift ;;
    --reason) REASON="${2:-}"; shift 2 ;;
    --routing-config) ROUTING_CONFIG="${2:-}"; shift 2 ;;
    --profiles-dir) PROFILES_DIR="${2:-}"; shift 2 ;;
    --locks-dir) LOCKS_DIR="${2:-}"; shift 2 ;;
    --sessions-log) SESSIONS_LOG="${2:-}"; shift 2 ;;
    --escalated-from) ESCALATED_FROM="${2:-}"; shift 2 ;;
    --) shift; EXTRA_ARGS=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    *) echo "session: argumento desconocido: $1" >&2; usage; exit 2 ;;
  esac
done

[ -n "$SPEC_ARG" ] || { echo "session: falta --spec" >&2; usage; exit 2; }

if [ "$FORCE" -eq 1 ] && [ -z "$REASON" ]; then
  echo "session: --force requiere --reason no vacío" >&2
  exit 2
fi

# --- RF-01.2: la spec debe existir --------------------------------------

if ! SPEC_FILE="$(resolve_spec "$SPEC_ARG")" || [ ! -f "$SPEC_FILE" ]; then
  echo "session: no se pudo resolver spec '$SPEC_ARG'" >&2
  exit 2
fi

# id canónico — misma normalización que spec_id_of en scripts/spec (0003)
SPEC_ID="$(basename "$SPEC_FILE" | grep -oE '^[0-9]{4}' || true)"
[ -z "$SPEC_ID" ] && SPEC_ID="$(basename "$SPEC_FILE" .md)"

# --- RF-01.3: spec lint ---------------------------------------------------

if ! "$REPO_ROOT/scripts/spec" lint "$SPEC_FILE"; then
  echo "session: gate falló — spec lint no pasa" >&2
  exit 1
fi

# --- RF-01.4: estado -------------------------------------------------------

STATUS="$(fm_field "$SPEC_FILE" status)"
case "$STATUS" in
  approved|implementing) ;;
  *)
    echo "session: gate falló — estado '$STATUS' no es approved ni implementing" >&2
    exit 1
    ;;
esac

# --- RF-01.5: tier vs. route ------------------------------------------------

set +e
ROUTE_OUTPUT="$("$REPO_ROOT/scripts/route" --spec "$SPEC_FILE" --routing-config "$ROUTING_CONFIG")"
ROUTE_EXIT=$?
set -e
echo "$ROUTE_OUTPUT"

if [ "$ROUTE_EXIT" -eq 2 ]; then
  echo "session: gate falló — route bloqueó la spec (hard_exclusions)" >&2
  exit 1
elif [ "$ROUTE_EXIT" -ne 0 ]; then
  echo "session: gate falló — scripts/route terminó con error" >&2
  exit 1
fi

ROUTE_TIER="$(printf '%s\n' "$ROUTE_OUTPUT" | grep -oE 'TIER=[AB]' | head -1 | cut -d= -f2)"
case "$TIER" in
  personal) TIER_LETTER=A ;;
  work) TIER_LETTER=B ;;
esac

if [ "$ROUTE_TIER" != "$TIER_LETTER" ] && [ "$FORCE" -ne 1 ]; then
  echo "session: gate falló — tier pedido '$TIER' ($TIER_LETTER) difiere del de route ('$ROUTE_TIER'); usá --force --reason para anular" >&2
  exit 1
fi

# --- RF-04: exclusión cruzada de spec (antes de tocar el lock propio) ------

OTHER_TIER="work"
[ "$TIER" = "work" ] && OTHER_TIER="personal"
OTHER_LOCKDIR="$LOCKS_DIR/$OTHER_TIER.lock"

if [ -d "$OTHER_LOCKDIR" ]; then
  OTHER_PID="$(cat "$OTHER_LOCKDIR/pid" 2>/dev/null || true)"
  if [ -n "$OTHER_PID" ] && kill -0 "$OTHER_PID" 2>/dev/null; then
    OTHER_SPEC_ID="$(grep '^spec_id=' "$OTHER_LOCKDIR/meta" 2>/dev/null | cut -d= -f2)"
    if [ "$OTHER_SPEC_ID" = "$SPEC_ID" ]; then
      echo "session: la spec '$SPEC_ID' ya está abierta en el tier '$OTHER_TIER'" >&2
      exit 1
    fi
  fi
fi

# --- RF-03: lock por tier, con detección de huérfanos ----------------------

mkdir -p "$LOCKS_DIR"
LOCKDIR="$LOCKS_DIR/$TIER.lock"

try_acquire_once() {
  if mkdir "$LOCKDIR" 2>/dev/null; then
    return 0
  fi
  local pid
  pid="$(cat "$LOCKDIR/pid" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  echo "session: lock huérfano en '$LOCKDIR' (PID ${pid:-?} no vive) — reclamando" >&2
  rm -rf "$LOCKDIR"
  return 2
}

RC=0
try_acquire_once || RC=$?

if [ "$RC" -eq 2 ]; then
  # huérfano reclamado en try_acquire_once: reintenta una sola vez (RF-03)
  RC=0
  mkdir "$LOCKDIR" 2>/dev/null || RC=1
fi

if [ "$RC" -ne 0 ]; then
  echo "session: ya hay una sesión viva en el tier '$TIER'" >&2
  exit 1
fi

echo "$$" > "$LOCKDIR/pid"
STARTED_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
{
  echo "spec_id=$SPEC_ID"
  echo "tier=$TIER"
  echo "started_at=$STARTED_AT"
} > "$LOCKDIR/meta"

# --- RF-01/02/03 de spec 0006 (not in this snapshot): captura de estado al
# abrir la sesión, para el registro de sessions/index.jsonl. Lectura NO
# fatal de workspace_root acá — el chequeo real y fatal del perfil sigue
# más abajo sin tocar su orden (RF-04 de 0004); esto sólo acota el git
# diff de files_touched, con "." (repo root) de default si el perfil
# todavía no se pudo leer en este punto del script.
SESSION_ID="$(gen_session_id)"
SPEC_VERSION="$(fm_int "$SPEC_FILE" version 1)"
WORKSPACE_ROOT_EARLY="$(yaml_field "$PROFILES_DIR/$TIER.yaml" workspace_root 2>/dev/null || true)"
[ -z "$WORKSPACE_ROOT_EARLY" ] && WORKSPACE_ROOT_EARLY="."
WORKSPACE_ABS="$(to_abs "$WORKSPACE_ROOT_EARLY")"
SESSION_START_HEAD="$(git -C "$WORKSPACE_ABS" rev-parse HEAD 2>/dev/null || true)"

# --- RF-01 de 0006: trap ampliado. Antes de liberar el lock (RF-03 de
# 0004), construye y appendea la línea de sessions/index.jsonl. Todo el
# bloque de construcción va envuelto en "{ ... } || true": bajo
# set -euo pipefail, si cualquier paso fallara sin estar exceptuado, el
# trap podría cortarse ANTES de "rm -rf $LOCKDIR" — dejando un lock
# huérfano que hoy (0004, un solo rm -rf como trap completo) nunca puede
# pasar. "rm -rf $LOCKDIR" queda como la única línea fuera del bloque,
# siempre la última instrucción de on_exit (RNF-02 de 0006: no regresión
# sobre RF-03/D8 de 0004).
#
# on_exit es idempotente a propósito: bash no termina el script al
# manejar un trap de INT/TERM/HUP (a diferencia de EXIT) salvo que el
# handler llame a "exit" explícitamente — cosa que 0004 nunca hizo (su
# trap original era sólo "rm -rf $LOCKDIR", inocuo repetido) y que 0006
# tampoco agrega, para no cambiar cuándo termina el proceso (RNF-02: no
# regresión de timing/señales sobre 0004). Consecuencia real: ante una
# señal recibida mientras el hijo todavía corre, el trap corre UNA VEZ
# ahí (con CHILD_EXIT todavía sin setear → outcome=aborted, exactamente
# lo que RF-02 pide), pero el script sigue esperando al hijo y, cuando
# éste termina solo, dispara el trap de EXIT una SEGUNDA vez — con
# CHILD_EXIT ya seteado, que daría outcome=completed, contradiciendo lo
# que ya se registró. SESSION_LOG_WRITTEN evita esa segunda escritura:
# la línea se appendea una sola vez, con el estado real del momento en
# que el trap corrió por primera vez.
CHILD_EXIT=""
SESSION_LOG_WRITTEN=0
on_exit() {
  if [ "$SESSION_LOG_WRITTEN" -eq 0 ]; then
    SESSION_LOG_WRITTEN=1
    {
      local outcome ended_at ft vr routing_rule override_reason_json score signals_json workspace_esc escalated_from_json tier_full line

      if [ -n "$CHILD_EXIT" ] && [ "$CHILD_EXIT" -eq 0 ]; then
        outcome=completed
      else
        outcome=aborted
      fi
      ended_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

      ft="$(files_touched_count "$SESSION_START_HEAD" "$WORKSPACE_ABS")"
      vr="$(verify_result_for "$outcome" "$SPEC_FILE")"

      if [ "$FORCE" -eq 1 ]; then
        routing_rule="manual-override"
        override_reason_json="\"$(json_escape "$REASON")\""
      else
        routing_rule="$(route_extract "$ROUTE_OUTPUT" RULE)"
        override_reason_json="null"
      fi
      score="$(route_extract "$ROUTE_OUTPUT" SCORE)"
      signals_json="$(signals_to_json "$(route_extract "$ROUTE_OUTPUT" SIGNALS)")"
      workspace_esc="$(json_escape "$WORKSPACE_ABS")"
      if [ -n "$ESCALATED_FROM" ]; then
        escalated_from_json="\"$(json_escape "$ESCALATED_FROM")\""
      else
        escalated_from_json="null"
      fi
      tier_full="TIER_$TIER_LETTER"

      line=$(build_session_line "$SESSION_ID" "$SPEC_ID" "$SPEC_VERSION" "$STARTED_AT" "$ended_at" "$tier_full" "$TIER" "$routing_rule" "$override_reason_json" "$score" "$signals_json" "$escalated_from_json" "$workspace_esc" "$ft" "$vr" "$outcome" "")

      append_session_line "$SESSIONS_LOG" "$LOCKS_DIR" "$line"
    } || true
  fi
  rm -rf "$LOCKDIR"
}
trap on_exit EXIT INT TERM HUP

# --- RF-04: aislamiento de entorno -------------------------------------------

PROFILE_FILE="$PROFILES_DIR/$TIER.yaml"
[ -f "$PROFILE_FILE" ] || { echo "session: falta el perfil '$PROFILE_FILE'" >&2; exit 1; }

CLAUDE_CONFIG_DIR="$(to_abs "$(yaml_field "$PROFILE_FILE" claude_config_dir)")"
DSH_HOME="$(to_abs "$(yaml_field "$PROFILE_FILE" dsh_home)")"
SESSION_WEB_UI_PORT="$(yaml_field "$PROFILE_FILE" web_ui_port)"
SESSION_TIER="$TIER"
SESSION_SPEC_ID="$SPEC_ID"
# SESSION_WORKSPACE: mismo valor ya resuelto arriba para RF-03 de 0006
# (files_touched) — se reexporta acá porque recién en este punto el resto
# de las variables de entorno de la sesión ya se exportan; no se recalcula.
SESSION_WORKSPACE="$WORKSPACE_ABS"
CLAUDE_BINARY="$(to_abs "$(yaml_field "$PROFILE_FILE" claude_binary)")"
export CLAUDE_CONFIG_DIR DSH_HOME SESSION_WEB_UI_PORT SESSION_TIER SESSION_SPEC_ID SESSION_WORKSPACE

[ -x "$CLAUDE_BINARY" ] || { echo "session: el binario del perfil no es ejecutable: '$CLAUDE_BINARY'" >&2; exit 1; }

# --- RF-02: lanzamiento como proceso hijo en foreground (nunca exec) --------
# "${EXTRA_ARGS[@]}" sin guardia rompe con "unbound variable" bajo set -u en
# bash 3.2 (el que trae macOS por default) cuando el array está vacío — de
# ahí el chequeo de "${#EXTRA_ARGS[@]}" antes de expandirlo.
#
# Lanzamiento en background + poll de kill -0 (no un "wait" bloqueante ni
# el foreground plano original): spec 0004 (not in this snapshot) §7 D11 punto 2
# documenta por qué — bajo bash 3.2, tanto el foreground plano como
# "child & wait" dejan la entrega de INT/TERM/HUP sin observar de forma
# confiable mientras el hijo sigue vivo; el poll-loop es el único de los
# tres mecanismos probados que dio 10/10 confiable (con teardown de test
# correcto). Sigue siendo proceso hijo real, nunca exec, y el trap sigue
# activo durante toda la espera — RF-02 no cambia de contrato.
#
# "$LOCKDIR/child_started": marcador explícito, escrito por este mismo
# proceso en el instante justo antes de entrar al poll-loop — no una
# señal indirecta inferida desde el hijo (p.ej. un archivo que el propio
# binario lanzado escriba a su arranque), porque no hay garantía de orden
# entre "el hijo ya corrió sus primeras líneas" y "este proceso ya entró
# al while": ambos ocurren de forma concurrente apenas se resuelve el "&".
# Un test que espere por este archivo espera por el evento real que le
# importa (spec 0006 (not in this snapshot) CA-15/CA-16 lo consumen así).
# "$LOCKDIR/child_pid" (spec 0007 (not in this snapshot) RF-01) sigue el mismo
# criterio, mismo instante: el PID real del hijo, para que scripts/kill
# pueda señalizarlo directamente en vez de sólo al wrapper.

set +e
if [ "${#EXTRA_ARGS[@]}" -gt 0 ]; then
  "$CLAUDE_BINARY" "${EXTRA_ARGS[@]}" &
else
  "$CLAUDE_BINARY" &
fi
CHILD_PID=$!
: > "$LOCKDIR/child_started"
echo "$CHILD_PID" > "$LOCKDIR/child_pid"
while kill -0 "$CHILD_PID" 2>/dev/null; do
  sleep 0.1
done
wait "$CHILD_PID"
CHILD_EXIT=$?
set -e

exit "$CHILD_EXIT"
