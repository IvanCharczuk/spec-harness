#!/usr/bin/env bash
# RF-17 — Bootstrap idempotente.
# Valida Node, crea .state/, materializa perfiles, instala hooks, verifica
# specs/0001-repo-maestro.md e imprime los pasos de login manual pendientes.
# No escribe credenciales ni ejecuta login (B-08).
set -euo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/common.sh
source "$SELF_DIR/lib/common.sh"
cd "$REPO_ROOT"
# shellcheck source=lib/worktree.sh
source "$SELF_DIR/lib/worktree.sh"

# RF-04 de 0052: en un worktree vinculado (git-dir distinto del git-common-dir)
# se bloquea git push en el settings.local.json; el checkout principal no se toca.
# Va temprano, antes de pasos que puedan fallar.
if [ "$(cd "$(git rev-parse --git-dir)" && pwd -P)" != "$(cd "$(git rev-parse --git-common-dir)" && pwd -P)" ]; then
  wt_bloquear_push "$REPO_ROOT"
fi

exec_after() {
  chmod +x "$1"
}

echo "== repo-maestro bootstrap =="

# --- 1) Node (RNF-01) --------------------------------------------------------
echo "[1/9] Node"
if ! check_node_range; then
  echo "  ERROR: Node $(node_version_string) fuera de rango soportado (^22.19.0 || >=24.0.0)."
  echo "  dsh no arranca fuera de este rango; bootstrap aborta (RF-17, RNF-01)."
  exit 1
fi
echo "  Node $(node_version_string) dentro del rango."

# --- 2) .state/ (RF-14) -------------------------------------------------------
echo "[2/9] .state/"
mkdir -p "$REPO_ROOT/.state/claude/personal" \
         "$REPO_ROOT/.state/claude/work" \
         "$REPO_ROOT/.state/dsh/personal" \
         "$REPO_ROOT/.state/dsh/work" \
         "$REPO_ROOT/.state/locks"
echo "  .state/{claude,dsh}/{personal,work}, .state/locks listos."

# --- 3) .gitignore, README, AGENTS.md ---------------------------------------
echo "[3/9] archivos de raíz"
write_if_missing "$REPO_ROOT/.gitignore" <<'EOF'
.state/
*.credentials.yaml
.env
.env.*
sessions/raw/
.DS_Store
EOF

write_if_missing "$REPO_ROOT/README.md" <<'EOF'
# repo-maestro

Repo spec-driven que centraliza la operación de DeepSeek Harness (dsh) sobre dos
backends Claude Code separados (Tier A personal, Tier B work), ruteando por
complejidad. Ver `specs/0001-repo-maestro.md` para la spec completa.

## Arranque

```sh
scripts/bootstrap   # crea el árbol, .state/, perfiles y hooks (idempotente)
scripts/doctor      # audita el entorno resultante
```

`bootstrap` no loguea ninguna cuenta. Después de correrlo, loguear manualmente
cada tier con el `CLAUDE_CONFIG_DIR` que imprime al final.

## Estado de esta pasada

Esta iteración del repo implementa únicamente RF-01 (estructura de §5.1),
RF-17 (bootstrap) y RF-18 (doctor) de `specs/0001-repo-maestro.md`. El resto de
los scripts (`spec`, `route`, `session`, `verify`, `escalate`, `kill`) son stubs
que indican en qué RF quedan pendientes de implementar; correrlos falla a
propósito con `exit 1`.
EOF

write_if_missing "$REPO_ROOT/AGENTS.md" <<'EOF'
# AGENTS.md

Contrato común para cualquier agente (dsh o Claude Code) que opere en este
repo, sin importar el tier (RF-16):

1. Leer la spec activa (`specs/<id>-*.md`) antes de tocar nada.
2. No exceder el §Alcance de esa spec.
3. Declarar escalado apenas se cruce un disparador duro o el umbral de
   complejidad — no seguir de largo con más alcance del que la spec cubre.

La profundidad de planificación exigida, la política de aprobación de
comandos destructivos y la verbosidad del log difieren por tier; ver
`templates/CLAUDE.md.personal` y `templates/CLAUDE.md.work` (RF-16, pendiente).
EOF

# --- 4) config/ (RNF-04, RF-19, stub de RF-05) ------------------------------
echo "[4/9] config/"
write_if_missing "$REPO_ROOT/config/versions.yaml" <<'EOF'
# RNF-04 — pin exacto, prohibido rango abierto.
node_range: "^22.19.0 || >=24.0.0"   # RNF-01, valor firme (definido en la spec)

# [SIN CONFIRMAR] — ver B-05: dsh en developer preview, contrastar contra
# github.com/deepseek-ai/deepseek-harness antes de fijar versión.
dsh_version: null

# [SIN CONFIRMAR] — ver B-06 y docs.claude.com antes de fijar versión.
claude_code_version: null
EOF

write_if_missing "$REPO_ROOT/config/routing.yaml" <<'EOF'
# Pendiente — ver RF-05, RF-06, RF-07, RF-24 (spec hija: scorer de complejidad).
# Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF

write_if_missing "$REPO_ROOT/config/plugins.lock.yaml" <<'EOF'
# Pendiente — ver RF-19 (allowlist de plugins con versión/hash pineado).
# Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
plugins: []
EOF

write_if_missing "$REPO_ROOT/config/profiles/personal.yaml" <<'EOF'
# config/profiles/personal.yaml — RF-13/§5.2. Rutas relativas a la raíz del repo.
tier: personal
claude_config_dir: ".state/claude/personal"
dsh_home: ".state/dsh/personal"
workspace_root: "."
web_ui_port: 8843
escalation_enabled: true
claude_binary: "bin/claude-personal"

# Grupo B — placeholder explícito, sin inventar valor definitivo.
sandbox_backend: null   # [SIN CONFIRMAR] — ver B-05
plugins: []              # pendiente RF-19
context_files: []        # pendiente RF-16 (templates/CLAUDE.md.personal)
approval_policy: null    # [SIN CONFIRMAR] — ver RF-16
EOF

write_if_missing "$REPO_ROOT/config/profiles/work.yaml" <<'EOF'
# config/profiles/work.yaml — RF-13/§5.2. Rutas relativas a la raíz del repo.
tier: work
claude_config_dir: ".state/claude/work"
dsh_home: ".state/dsh/work"
workspace_root: "."
web_ui_port: 8844
escalation_enabled: false
claude_binary: "bin/claude-work"

# Grupo B — placeholder explícito, sin inventar valor definitivo.
sandbox_backend: null   # [SIN CONFIRMAR] — ver B-05
plugins: []              # pendiente RF-19
context_files: []        # pendiente RF-16 (templates/CLAUDE.md.work)
approval_policy: null    # [SIN CONFIRMAR] — ver RF-16
EOF

# --- 5) bin/ (RF-15 mínimo) --------------------------------------------------
echo "[5/9] bin/"
write_if_missing "$REPO_ROOT/bin/claude-personal" <<'EOF'
#!/usr/bin/env bash
# wrapper base RF-15 — delegación completa a dsh pendiente de B-06
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CLAUDE_CONFIG_DIR="$SELF_DIR/../.state/claude/personal"
exec claude "$@"
EOF
exec_after "$REPO_ROOT/bin/claude-personal"

write_if_missing "$REPO_ROOT/bin/claude-work" <<'EOF'
#!/usr/bin/env bash
# wrapper base RF-15 — delegación completa a dsh pendiente de B-06
set -euo pipefail
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export CLAUDE_CONFIG_DIR="$SELF_DIR/../.state/claude/work"
exec claude "$@"
EOF
exec_after "$REPO_ROOT/bin/claude-work"

# --- 6) scripts/ stubs (RF-01: árbol completo) ------------------------------
echo "[6/9] scripts/ (stubs fuera de alcance de esta pasada)"

write_stub_script() {
  local name="$1" rfs="$2"
  local path="$REPO_ROOT/scripts/$name"
  write_if_missing "$path" <<EOF
#!/usr/bin/env bash
set -euo pipefail
echo "$name: no implementado — ver $rfs (spec hija pendiente)" >&2
exit 1
EOF
  exec_after "$path"
}

write_stub_script "spec" "RF-02, RF-03, RF-08"
write_stub_script "route" "RF-05, RF-06, RF-07"
write_stub_script "session" "RF-04, RF-21"
write_stub_script "verify" "RF-09"
write_stub_script "escalate" "RF-11"
write_stub_script "kill" "RF-22"

# --- 7) templates/ y docs/ stubs --------------------------------------------
echo "[7/9] templates/ y docs/"
write_if_missing "$REPO_ROOT/templates/spec.md" <<'EOF'
Pendiente — plantilla canónica de spec, ver RF-02.
Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF
write_if_missing "$REPO_ROOT/templates/CLAUDE.md.personal" <<'EOF'
Pendiente — contrato de agente Tier A, ver RF-16.
Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF
write_if_missing "$REPO_ROOT/templates/CLAUDE.md.work" <<'EOF'
Pendiente — contrato de agente Tier B, ver RF-16.
Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF
write_if_missing "$REPO_ROOT/docs/spec-lifecycle.md" <<'EOF'
Pendiente — estados, transiciones y quién las dispara, ver RF-08.
Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF
write_if_missing "$REPO_ROOT/docs/complexity-scoring.md" <<'EOF'
Pendiente — señales, pesos y ejemplos resueltos a mano, ver RF-05.
Placeholder creado por bootstrap (RF-17) para completar el árbol de §5.1.
EOF
write_if_missing "$REPO_ROOT/docs/risk-register.md" <<'EOF'
Pendiente — riesgos aceptados de §7 (B-01..B-10) transcriptos con fecha de
aceptación. Placeholder creado por bootstrap (RF-17) para completar el árbol
de §5.1.
EOF
write_if_missing "$REPO_ROOT/docs/runbook.md" <<'EOF'
Pendiente — incidentes operativos (cruce de sesión, lock colgado), ver RF-21,
RF-22. Placeholder creado por bootstrap (RF-17) para completar el árbol de
§5.1.
EOF

# --- 8) .githooks/ passthrough + wiring (RF-17 "instala hooks") -------------
echo "[8/9] .githooks/"
write_if_missing "$REPO_ROOT/.githooks/pre-commit" <<'EOF'
#!/usr/bin/env bash
echo "pre-commit: passthrough — validación real pendiente (RF-20)"
exit 0
EOF
exec_after "$REPO_ROOT/.githooks/pre-commit"

write_if_missing "$REPO_ROOT/.githooks/commit-msg" <<'EOF'
#!/usr/bin/env bash
echo "commit-msg: passthrough — validación real pendiente (RF-10.1)"
exit 0
EOF
exec_after "$REPO_ROOT/.githooks/commit-msg"

git config core.hooksPath .githooks
echo "  core.hooksPath -> .githooks"

# --- 9) sessions/, specs/archived/, verificación de specs/0001 -------------
echo "[9/9] sessions/, specs/archived/, specs/0001"
mkdir -p "$REPO_ROOT/specs/archived" "$REPO_ROOT/sessions/raw"
touch "$REPO_ROOT/specs/archived/.gitkeep" "$REPO_ROOT/sessions/raw/.gitkeep"
[ -f "$REPO_ROOT/sessions/index.jsonl" ] || : > "$REPO_ROOT/sessions/index.jsonl"

if [ ! -f "$REPO_ROOT/specs/0001-repo-maestro.md" ]; then
  echo "  ERROR: falta specs/0001-repo-maestro.md — bootstrap no puede sintetizar" >&2
  echo "  el contenido de la spec desde cero; commitearla manualmente primero." >&2
  exit 1
fi
echo "  specs/0001-repo-maestro.md presente, sin tocar."

# --- 10) cordis.patch.yml ----------------------------------------------------
# RF-01 de specs/0029: el archivo ya no se versiona (git rm --cached, en
# .gitignore) porque contiene el path absoluto de ESTE checkout; lo
# regenera este paso en cada corrida de bootstrap. Si el generador falla
# (perfil sin resolver, Node fuera de rango para type-stripping), el motivo
# se imprime y bootstrap sigue con exit 0: el patch sólo importa si se usa
# dsh, y doctor RF-18.11 pasa informativo cuando el archivo no existe.
echo "[10] cordis.patch.yml"
GEN_SCRIPT="$REPO_ROOT/dsh-plugins/dsh-frontend/scripts/generate-cordis-patch.ts"
if [ -f "$GEN_SCRIPT" ]; then
  if ! node "$GEN_SCRIPT"; then
    echo "  generate-cordis-patch falló (ver motivo arriba); bootstrap continúa (0029 RF-01.3)."
  fi
else
  echo "  sin generador, nada que hacer."
fi
# --- fin 10) ---
echo
echo "== Pendiente — login manual (B-08, bootstrap sólo lo enumera) =="
echo "  1) CLAUDE_CONFIG_DIR=$REPO_ROOT/.state/claude/personal claude   (Tier A / personal)"
echo "  2) CLAUDE_CONFIG_DIR=$REPO_ROOT/.state/claude/work claude       (Tier B / work)"
echo
echo "bootstrap terminado."

# CA-01 se verifica manualmente: el operador revisa el diff y commitea.
# Automatización pendiente de RF-08 (transición spec verify).
