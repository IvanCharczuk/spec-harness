#!/usr/bin/env bash
# Binario mock para las CA de spec 0006 (not in this snapshot). Extiende el
# mock de spec 0004 (not in this snapshot) (mismos hooks FAKE_CLAUDE_SLEEP/
# FAKE_CLAUDE_EXIT/FAKE_CLAUDE_CAPTURE) con FAKE_CLAUDE_COMMIT_FILES, para
# probar el heurístico de files_touched (RF-03 de 0006) sin tocar nunca el
# repo real: usa $SESSION_WORKSPACE (exportado por scripts/session,
# resuelto de workspace_root del perfil), que en los perfiles fake de esta
# spec apunta a .state/test-workspace-session-log/ — ya excluido del repo
# real por .gitignore (RF-20 madre).

if [ -n "${FAKE_CLAUDE_CAPTURE:-}" ]; then
  {
    echo "CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR:-}"
    echo "DSH_HOME=${DSH_HOME:-}"
    echo "SESSION_WEB_UI_PORT=${SESSION_WEB_UI_PORT:-}"
    echo "SESSION_TIER=${SESSION_TIER:-}"
    echo "SESSION_SPEC_ID=${SESSION_SPEC_ID:-}"
  } > "$FAKE_CLAUDE_CAPTURE"
fi

ws="${SESSION_WORKSPACE:-.}"
mkdir -p "$ws"
if [ ! -d "$ws/.git" ]; then
  git -C "$ws" init -q
  git -C "$ws" -c user.email=tester@localhost -c user.name=fake-claude commit -q --allow-empty -m init
fi

if [ -n "${FAKE_CLAUDE_COMMIT_FILES:-}" ]; then
  n=0
  while [ "$n" -lt "$FAKE_CLAUDE_COMMIT_FILES" ]; do
    n=$((n + 1))
    echo "fake content $$-$n" > "$ws/fake-file-$$-$n.txt"
  done
  git -C "$ws" add -A
  git -C "$ws" -c user.email=tester@localhost -c user.name=fake-claude commit -q -m "fake commit ($FAKE_CLAUDE_COMMIT_FILES files)"
fi

sleep "${FAKE_CLAUDE_SLEEP:-0}"
exit "${FAKE_CLAUDE_EXIT:-0}"
